# 本地开发：cp .env.example .env，pnpm dev 会读取它
# Docker 部署：放在 docker-compose.yml 同目录，至少填好 MASTER_KEY、POSTGRES_PASSWORD、PUBLIC_URL
# 其他可选变量见 https://damail.app/zh/docs/configuration/

# 加密邮箱凭证、签发会话：openssl rand -hex 32，务必备份
# Docker 部署必填；本地开发留空时自动生成到 data/master.key
MASTER_KEY=
POSTGRES_PASSWORD=change-me
# 对外访问地址；通过 HTTPS 访问时 COOKIE_SECURE 设为 true
PUBLIC_URL=http://localhost:8787
COOKIE_SECURE=false

# Docker 端口映射和镜像版本，默认 127.0.0.1:8787、latest
# DAMAIL_BIND=0.0.0.0
# DAMAIL_PORT=8787
# DAMAIL_VERSION=v0.2.0

# 只在本地开发时生效，Docker 里由 docker-compose.yml 决定
DATABASE_URL=postgres://damail:damail@127.0.0.1:55434/damail
HOST=127.0.0.1
