---
import logo from '../assets/logo.svg?raw';
import { HOME } from '../i18n/home';
import Brand from './Brand.astro';
import Icon, { type IconName } from './Icon.astro';
import '../styles/home.css';

interface Props {
  locale: 'zh' | 'en';
}
const { locale } = Astro.props;
const t = HOME[locale];
const app = t.app;
const asst = app.assistant;
const f = t.features;
const ag = t.agents;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = locale === 'zh' ? `${base}zh/` : base;
const REPO = 'https://github.com/gopkg-dev/damail';
const docs = (path = '') => `${prefix}docs/${path}`;
// 分享卡片（X / Telegram / Slack 等）只认绝对地址，所以拼上 astro.config 里的 site
const pageUrl = new URL(prefix, Astro.site).href;
const OG_IMAGE = new URL(`${base}og-image.png`, Astro.site).href;

const INSTALL = 'curl -fsSL https://damail.app/install.sh | sh';
// 侧边栏图标顺序和真实界面一致：概览 邮件 草稿 订阅 通讯录 | 报告 统计 | 智能 审计 …… 助手 设置
const RAIL_ICONS: IconName[] = ['home', 'inbox', 'file', 'mega', 'contacts', 'report', 'chart', 'cpu', 'shield', 'chat', 'gear'];
const VIEW_ICONS: IconName[] = ['inbox', 'star', 'clock', 'mail', 'star', 'send', 'tag'];
// 「AI Agent」区块里列出的客户端
const AGENT_CLIENTS: [name: string, logo: string][] = [
  ['Claude Duet', 'claude'],
  ['ChatGPT dots', 'openai'],
  ['Grok Bot', 'grok'],
  ['Meta Muse', 'meta'],
  ['Claude Code', 'claude'],
  ['Cursor', 'cursor'],
];
// 终端演示的输出行（和 install.sh 一致）。对齐靠空格，所以整行用字符串生成，避免模板压缩空白
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const STEP = (s: string): [string, string] => ['', `<em>==&gt;</em> ${esc(s)}`];
const OK = (s: string): [string, string] => ['dim', ` <s>✔</s> ${s}`];
const TERM: [cls: string, html: string][] = [
  ['dim', 'Language / 语言'],
  ['dim', '  1) 简体中文   2) English'],
  ['', `Choose / 请选择 [${t.start.choice}]: <b>${t.start.choice}</b>`],
  ...t.start.lines.map(STEP),
  ['dim', '[+] Pulling 2/2'],
  OK('db  Pulled'),
  OK('app Pulled'),
  STEP(t.start.starting),
  ['dim', '[+] Running 3/3'],
  OK('Network damail_default  Created'),
  OK('Container damail-db-1   Healthy'),
  OK('Container damail-app-1  Started'),
  STEP(t.start.waiting),
  ['', ' '],
  ['ok', esc(t.start.ready)],
  ...t.start.summary.map(([k, v, style]): [string, string] => (style === 'url' ? ['', `  ${esc(k)}<u>${esc(v)}</u>`] : ['dim', `  ${esc(k)}${esc(v)}`])),
];
const GITHUB_PATH =
  'M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z';
---

<!doctype html>
<html lang={t.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="DaMail" />
    <meta property="og:locale" content={t.lang.replace('-', '_')} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content={t.title} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" hreflang="en" href={base} />
    <link rel="alternate" hreflang="zh-CN" href={`${base}zh/`} />
    <link rel="alternate" hreflang="x-default" href={base} />
    {/* 和文档页（Starlight）共用 localStorage 里的 starlight-theme：light / dark / 空 = 跟随系统 */}
    <script is:inline>
      (() => {
        let saved = '';
        try {
          saved = localStorage.getItem('starlight-theme') || '';
        } catch {}
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="bg" aria-hidden="true"></div>

    <header class="nav">
      <div class="nav-in">
        <a class="brand" href={prefix}><span class="logo" set:html={logo} /><span>DaMail</span></a>
        <nav class="nav-links">
          <a href="#features">{t.nav.features}</a>
          <a href="#agents">{t.nav.agents}</a>
          <a href="#start">{t.nav.start}</a>
          <a href={docs()}>{t.nav.docs}</a>
        </nav>
        <div class="nav-act">
          <a class="nbtn" href={`${base}${t.nav.langHref}`} hreflang={t.nav.langCode}><Icon name="globe" size={16} /><span>{t.nav.switchLang}</span></a>
          <i class="nav-sep" aria-hidden="true"></i>
          <button class="nbtn sq" type="button" id="theme-toggle" aria-label={t.nav.theme} title={t.nav.theme}>
            <Icon name="sun" size={19} class="i-sun" />
            <Icon name="moon" size={18} class="i-moon" />
          </button>
          <a class="nbtn gh" href={REPO} aria-label="GitHub" title="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH}></path></svg>
            <span class="btn-count" data-stars hidden><Icon name="star" size={12} /><span data-stars-n></span></span>
          </a>
        </div>
      </div>
    </header>

    <main class="wrap">
      <section class="hero">
        <span class="pill">{t.hero.badge}</span>
        <h1>{t.hero.title[0]}<br /><span class="grad">{t.hero.title[1]}</span></h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="hero-act">
          <a class="btn primary" href="#start">{t.hero.primary}<Icon name="arrow" size={18} /></a>
          <a class="btn ghost" href={REPO}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH}></path></svg>
            {t.hero.secondary}
            <span class="btn-count" data-stars hidden><Icon name="star" size={13} /><span data-stars-n></span></span>
          </a>
        </div>
        <div class="cmd">
          <span>$</span><code>{INSTALL}</code>
          <button type="button" data-copy={INSTALL} data-copied={t.hero.copied} aria-label={t.hero.copy} title={t.hero.copy}><Icon name="copy" size={16} class="i-copy" /><Icon name="check" size={16} class="i-done" /></button>
        </div>

        {/* 产品界面：照真实界面复刻，数据都是虚构的 */}
        <div class="shot" aria-hidden="true">
          <div class="app">
            <div class="rail">
              <span class="r-logo" set:html={logo} />
              {
                app.rail.slice(0, 9).map((name, i) => (
                  <>
                    {(i === 5 || i === 7) && <hr />}
                    <span class:list={['r-item', { on: i === 1 }]}>
                      <Icon name={RAIL_ICONS[i]!} size={17} />
                      <span>{name}</span>
                      {i === 2 && <i class="r-badge">2</i>}
                    </span>
                  </>
                ))
              }
              <div class="r-bottom">
                <span class="r-item on"><Icon name="chat" size={17} /><span>{app.rail[9]}</span></span>
                <span class="r-item"><Icon name="gear" size={17} /><span>{app.rail[10]}</span></span>
                <span class="r-av">{app.avatar}</span>
              </div>
            </div>
            <div class="side">
              <div class="side-h"><b>{app.mail}</b><Icon name="menu" size={15} /></div>
              <div class="compose"><Icon name="pen" size={14} />{app.compose}</div>
              {
                app.views.map(([name, n, strong], i) => (
                  <span class:list={['side-item', { on: i === 0 }]}>
                    <Icon name={VIEW_ICONS[i]!} size={15} />
                    <span>{name}</span>
                    {n && <em class:list={{ blue: strong }}>{n}</em>}
                  </span>
                ))
              }
              <div class="side-sec">{app.accountsTitle}</div>
              {
                app.accounts.map(([logo, name, n, strong]) => (
                  <span class="side-item">
                    <Brand logo={logo} size={15} />
                    <span>{name}</span>
                    <em class:list={{ blue: strong }}>{n}</em>
                  </span>
                ))
              }
            </div>
            <div class="main">
              <div class="main-h">
                <b>{app.inbox}</b>
                <div class="search">
                  <Icon name="search" size={14} /><span>{app.search}</span><em><Icon name="bulb" size={13} />{app.aiSearch}</em>
                </div>
              </div>
              <div class="main-b">
                <div class="mlist">
                  <div class="ml-h">
                    <span class="cb"></span><span>{app.total}</span><span class="seg"><b>{app.all}</b><i>{app.unread}</i></span>
                  </div>
                  {
                    app.threads.map((m) => (
                      <div class:list={['mi', { unread: m.unread, on: m.on }]}>
                        <span class="av" style={`--c:${m.color}`}>{m.av}</span>
                        <div class="mi-c">
                          <div class="mi-1"><b>{m.from}</b><time>{m.time}</time></div>
                          <div class="mi-2">
                            <span class="sj">{m.subject}</span>
                            {m.tags.map(([name, tone]) => <em class={`tg ${tone}`}>{name}</em>)}
                            <span class="acct" style={`--d:${app.accounts[m.account]![4]}`}>{app.accounts[m.account]![1]}</span>
                          </div>
                          <div class="mi-3">{m.snippet}</div>
                        </div>
                      </div>
                    ))
                  }
                </div>
                <div class="read">
                  <div class="rd-h">
                    <h4>{app.reader.subject}</h4>
                    <span class="rd-act">
                      <Icon name="archive" size={16} /><Icon name="trash" size={16} /><Icon name="tag" size={16} /><span class="gold"><Icon name="star" size={16} /></span>
                    </span>
                  </div>
                  <div class="rd-from">
                    <span class="av" style="--c:#3b6cf6">{app.reader.av}</span>
                    <div>
                      <b>{app.reader.from}</b> <span>{app.reader.address}</span>
                      <div class="rd-to">{app.reader.to}</div>
                    </div>
                    <time>{app.reader.date}</time>
                  </div>
                  <span class="add-tag"><Icon name="plus" size={12} />{app.reader.addTag}</span>
                  <div class="ai">
                    <div class="ai-h">
                      <span class="ai-t"><Icon name="sparkles" size={14} />{app.reader.aiTitle}</span>
                      {app.reader.tags.map(([name, tone]) => <em class={`tg ${tone}`}>{name}</em>)}
                    </div>
                    <p>{app.reader.summary}</p>
                    <dl>{app.reader.fields.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
                  </div>
                  <div class="rd-body">{app.reader.body}</div>
                  <div class="rd-btns">
                    <span><Icon name="reply" size={14} />{app.reader.reply}</span>
                    <span><Icon name="forward" size={14} />{app.reader.forward}</span>
                  </div>
                </div>
              </div>
            </div>

            {/* 右下角的 AI 助手：循环演示输入问题、调用工具、流式回答 */}
            <div class="asst" data-asst data-q={asst.question} data-a={asst.answer} data-thinking={asst.thinking} data-thought={asst.thought}>
              <div class="as-h">
                <span class="as-ico"><Icon name="botcard" size={16} /></span><b>{asst.title}</b><Icon name="chev" size={13} />
                <span class="as-act"><Icon name="plus" size={14} /><Icon name="expand" size={13} /><Icon name="close" size={14} /></span>
              </div>
              <div class="as-b">
                <div class="as-welcome">
                  <span class="as-big"><Icon name="botcard" size={20} /></span>
                  <h5>{asst.hello}</h5>
                  <p>{asst.intro}</p>
                  <div class="as-grid">
                    {
                      asst.cards.map(([icon, title, desc]) => (
                        <div>
                          <span><Icon name={icon as IconName} size={13} /></span>
                          <b>{title}</b>
                          <em>{desc}</em>
                        </div>
                      ))
                    }
                  </div>
                </div>
                <div class="as-chat">
                  <div class="c-q">{asst.question}</div>
                  <div class="c-think"><span class="spin"></span><span class="c-think-t">{asst.thinking}</span></div>
                  {
                    asst.steps.map(([tool, arg, result]) => (
                      <div class="c-step">
                        <span class="c-st"><Icon name="check" size={9} /></span>
                        <b class="c-tool">{tool}</b>
                        <span class="c-arg">{arg}</span>
                        <em>{result}</em>
                      </div>
                    ))
                  }
                  <div class="c-ans">
                    <p class="c-text"></p>
                    {
                      asst.bills.map(([name, amount, due]) => (
                        <div class="c-bill">
                          <span>{name}</span>
                          <b>{amount}</b>
                          <time>{due}</time>
                        </div>
                      ))
                    }
                    <div class="c-cite"><Icon name="mail" size={10} />{asst.cited}</div>
                  </div>
                </div>
              </div>
              <div class="as-in">
                <div class="as-txt"><span class="as-typed"></span><i class="caret"></i><span class="as-ph">{asst.placeholder}</span></div>
                <div class="as-bar">
                  <span><Icon name="bolt" size={13} />Claude<Icon name="chev" size={12} /></span>
                  <span><Icon name="bulb" size={13} />{asst.think}<Icon name="chev" size={12} /></span>
                  <b><Icon name="up" size={16} /></b>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="logos">
        <div class="logos-h"><span>{t.logosTitle}</span></div>
        {/* 两份相同的列表首尾相接，向左平移一份的宽度后无缝循环；第二份只是视觉重复，读屏跳过 */}
        <div class="mq">
          <div class="mq-track">
            {
              [false, true].map((copy) => (
                <ul class="mq-list" aria-hidden={copy ? 'true' : undefined}>
                  {t.brands.map(([logo, name]) => (
                    <li>
                      <Brand logo={logo} size={34} />
                      <span>{name}</span>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
      </section>

      <section class="sec" id="features">
        <div class="head"><span class="kick">{f.kicker}</span><h2>{f.title}</h2></div>
        <div class="bento">
          <article class="tile wide">
            <div>
              <span class="t-ico"><Icon name="inbox" size={20} /></span>
              <h3>{f.sync.title}</h3>
              <p>{f.sync.desc}</p>
            </div>
            <div class="t-vis v-sync" aria-hidden="true">
              <div class="toast">
                <span class="av" style="--c:#f08c2e">{f.sync.toast[0]}</span>
                <div><b>{f.sync.toast[1]}</b><span>{f.sync.toast[2]}</span></div>
                <time>{f.sync.toast[3]}</time>
              </div>
              {
                f.sync.accounts.map(([logo, name]) => (
                  <div class="sync">
                    <Brand logo={logo} size={20} />
                    <b>{name}</b>
                    <span class="live">{f.sync.live}</span>
                  </div>
                ))
              }
            </div>
          </article>
          <article class="tile">
            <span class="t-ico"><Icon name="sparkles" size={20} /></span>
            <h3>{f.ai.title}</h3>
            <p>{f.ai.desc}</p>
            <div class="t-vis ai mini" aria-hidden="true">
              <div class="ai-h"><span class="ai-t"><Icon name="sparkles" size={13} />{f.ai.label}</span><em class="tg purple">{f.ai.tag}</em></div>
              <p>{f.ai.summary}</p>
              <div class="code">{f.ai.code}<span><Icon name="copy" size={13} /></span></div>
            </div>
          </article>
          <article class="tile">
            <span class="t-ico"><Icon name="chat" size={20} /></span>
            <h3>{f.ask.title}</h3>
            <p>{f.ask.desc}</p>
            <div class="t-vis v-chat" aria-hidden="true">
              <div class="q">{f.ask.question}</div>
              <div class="a"><span set:html={f.ask.answer} /><div class="cite"><Icon name="mail" size={13} />{f.ask.cited}</div></div>
            </div>
          </article>
          <article class="tile wide">
            <div>
              <span class="t-ico"><Icon name="bolt" size={20} /></span>
              <h3>{f.rules.title}</h3>
              <p>{f.rules.desc}</p>
            </div>
            <div class="t-vis v-rule" aria-hidden="true">
              {
                f.rules.rules.map(([cond, action]) => (
                  <div class="rule">
                    <span class="k">{f.rules.when}</span>
                    <span class="chip">{cond}</span>
                    <span class="arr"><Icon name="arrow" size={14} /></span>
                    <span class="chip blue">{action}</span>
                  </div>
                ))
              }
              <div class="push">
                <span class="push-ico" set:html={logo} />
                <div><b>{f.rules.push[0]}</b><span>{f.rules.push[1]}</span></div>
                <time>{f.rules.push[2]}</time>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="sec" id="agents">
        <div class="head">
          <span class="kick">{ag.kicker}</span>
          <h2>{ag.title}</h2>
          <p>{ag.lead}</p>
        </div>
        <div class="clients">
          {
            AGENT_CLIENTS.map(([name, logo]) => (
              <span>
                <Brand logo={logo} size={18} />
                {name}
              </span>
            ))
          }
        </div>
        <div class="flow3">
          <article class="fs">
            <div class="fs-h"><i>1</i><div><h3>{ag.consent.title}</h3><p>{ag.consent.desc}</p></div></div>
            <div class="fs-vis" aria-hidden="true">
              <div class="cs-top"><b>{ag.consent.heading}</b><span><Brand logo="openai" size={14} />{ag.consent.requests}</span></div>
              {
                ag.consent.scopes.map(([name, tag, tone, on]) => (
                  <div class:list={['cs-opt', { off: !on }]}>
                    <span class:list={['ck', { on }]}>{on && <Icon name="check" size={10} />}</span>
                    <b>{name}</b>
                    <em class={`tg ${tone}`}>{tag}</em>
                  </div>
                ))
              }
              <div class="cs-mb"><span>{ag.consent.mailboxes}</span><span class="cs-seg"><i>{ag.consent.all}</i><b>{ag.consent.selected}</b></span></div>
              <div class="cs-boxes">
                {
                  ag.consent.boxes.map(([logo, name], i) => (
                    <span class:list={{ on: i === 0 }}>
                      <Brand logo={logo} size={12} />
                      {name}
                    </span>
                  ))
                }
              </div>
              <div class="cs-btn"><span>{ag.consent.deny}</span><b>{ag.consent.allow}</b></div>
            </div>
          </article>
          <article class="fs">
            <div class="fs-h"><i>2</i><div><h3>{ag.run.title}</h3><p>{ag.run.desc}</p></div></div>
            <div class="fs-vis exec" aria-hidden="true">
              <div class="run-ask"><span><Brand logo="openai" size={14} /></span>{ag.run.ask}</div>
              {
                ag.run.steps.map(([tool, result, state]) => (
                  <div class={`run-step ${state}`}>
                    <span class="run-i"><Icon name={state === 'ok' ? 'check' : state === 'wait' ? 'clock' : 'lock'} size={11} /></span>
                    <b>{tool}</b>
                    <em>{result}</em>
                  </div>
                ))
              }
            </div>
          </article>
          <article class="fs">
            <div class="fs-h"><i>3</i><div><h3>{ag.approve.title}</h3><p>{ag.approve.desc}</p></div></div>
            <div class="fs-vis approve" aria-hidden="true">
              <div class="ap-top"><em class="tg orange">{ag.approve.pending}</em><span>{ag.approve.source}</span></div>
              {ag.approve.fields.map(([k, v]) => <div class="ap-row"><span>{k}</span>{v}</div>)}
              <p>{ag.approve.body}</p>
              <div class="ap-btn"><span>{ag.approve.reject}</span><span>{ag.approve.edit}</span><b><Icon name="send" size={12} />{ag.approve.send}</b></div>
              <div class="ap-undo"><Icon name="clock" size={11} />{ag.approve.undo}</div>
            </div>
          </article>
        </div>
      </section>

      <section class="sec">
        <div class="head"><span class="kick">{t.more.kicker}</span><h2>{t.more.title}</h2></div>
        <div class="more">
          {
            t.more.items.map(([icon, title, desc, color]) => (
              <div class={`m-card ${color}`}>
                <span class="m-ico"><Icon name={icon as IconName} size={18} /></span>
                <b>{title}</b>
                <span class="m-desc">{desc}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sec start" id="start">
        <div>
          <span class="kick">{t.start.kicker}</span>
          <h2>{t.start.title[0]}<br />{t.start.title[1]}</h2>
          <p class="st-lead">{t.start.lead}</p>
          <ol class="st-steps">
            {
              t.start.steps.map(([title, desc], i) => (
                <li>
                  <i>{i + 1}</i>
                  <div>
                    <b>{title}</b>
                    <span>{desc}</span>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="st-act">
            <a class="btn primary" href={docs('quick-start/')}>{t.start.docs}<Icon name="arrow" size={18} /></a>
          </div>
        </div>
        {/* 终端：打出安装命令，再逐行显示和 install.sh 一致的输出 */}
        <div class="tw">
          <div class="tw-bar">
            <i></i><i></i><i></i><span>Terminal</span>
            <button type="button" data-copy={INSTALL} data-copied={t.hero.copied} aria-label={t.hero.copy} title={t.hero.copy}><Icon name="copy" size={16} class="i-copy" /><Icon name="check" size={16} class="i-done" /></button>
          </div>
          <div class="tw-body" data-term data-cmd={INSTALL} aria-label={INSTALL}>
            <div class="tl show"><span class="tp">$</span> <span class="tw-cmd"></span><i class="tw-caret"></i></div>
            {TERM.map(([cls, html]) => <div class:list={['tl', cls]} set:html={html} />)}
          </div>
        </div>
      </section>

      <footer class="foot">
        <a class="brand" href={prefix}><span class="logo" set:html={logo} /><span>DaMail</span></a>
        <span>{t.footer.tagline}</span>
        <nav>
          <a href={docs()}>{t.footer.docs}</a>
          <a href={`${REPO}/releases`}>{t.footer.changelog}</a>
          <a href={`${REPO}/issues`}>{t.footer.issues}</a>
        </nav>
      </footer>
    </main>

    <script>
      const root = document.documentElement;
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      /** 元素进入视口（且页面在前台）时才播放演示，离开后暂停在下一轮开头 */
      const watch = (el: Element) => {
        const state = { visible: false };
        new IntersectionObserver(([e]) => (state.visible = !!e?.isIntersecting), { threshold: 0.3 }).observe(el);
        return async () => {
          while (!state.visible || document.hidden) await sleep(300);
        };
      };

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
      });

      // 复制按钮：成功后图标换成对勾；剪贴板接口不可用（如非 HTTPS）时退回 execCommand
      const copyText = async (text: string) => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
          document.body.append(ta);
          ta.select();
          const ok = document.execCommand('copy');
          ta.remove();
          return ok;
        }
      };
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        let timer = 0;
        btn.addEventListener('click', async () => {
          if (!(await copyText(btn.dataset.copy ?? ''))) return;
          btn.classList.add('done');
          clearTimeout(timer);
          timer = window.setTimeout(() => btn.classList.remove('done'), 2000);
        });
      });

      // GitHub Star 数：浏览器直接读公开 API（未登录每小时 60 次），本地缓存 1 小时；读不到就不显示
      const STARS_KEY = 'damail.site.stars';
      const fmtStars = (n: number) => (n < 1000 ? String(n) : `${(n / 1000).toFixed(n < 10_000 ? 1 : 0).replace(/\.0$/, '')}k`);
      const showStars = (n: number) =>
        document.querySelectorAll<HTMLElement>('[data-stars]').forEach((el) => {
          const label = el.querySelector('[data-stars-n]');
          if (label) label.textContent = fmtStars(n);
          el.title = `${n.toLocaleString()} stars`;
          el.hidden = false;
        });
      let cached: { n?: unknown; t?: unknown } | null = null;
      try {
        cached = JSON.parse(localStorage.getItem(STARS_KEY) ?? 'null');
      } catch {}
      if (typeof cached?.n === 'number') showStars(cached.n);
      if (typeof cached?.t !== 'number' || Date.now() - cached.t > 3600_000) {
        fetch('https://api.github.com/repos/gopkg-dev/damail', { headers: { Accept: 'application/vnd.github+json' } })
          .then((r) => (r.ok ? r.json() : null))
          .then((repo) => {
            const n = repo?.stargazers_count;
            if (typeof n !== 'number') return;
            showStars(n);
            try {
              localStorage.setItem(STARS_KEY, JSON.stringify({ n, t: Date.now() }));
            } catch {}
          })
          .catch(() => {});
      }

      // 助手演示：输入问题 → 发送 → 依次调用工具 → 流式回答，循环播放；减少动态效果时直接显示最终画面
      const panel = document.querySelector<HTMLElement>('[data-asst]');
      if (panel) {
        const $ = <T extends HTMLElement>(sel: string) => panel.querySelector<T>(sel)!;
        const { q = '', a = '', thinking = '', thought = '' } = panel.dataset;
        const typed = $('.as-typed'),
          send = $('.as-bar b'),
          think = $('.c-think'),
          thinkT = $('.c-think-t'),
          text = $('.c-text'),
          ask = $('.c-q'),
          ans = $('.c-ans'),
          cite = $('.c-cite');
        const steps = [...panel.querySelectorAll<HTMLElement>('.c-step')];
        const bills = [...panel.querySelectorAll<HTMLElement>('.c-bill')];
        const all = [ask, think, ...steps, ans, text, ...bills, cite];
        const show = (el: HTMLElement) => el.classList.add('show');
        if (reduced) {
          panel.classList.add('chatting');
          all.forEach(show);
          think.classList.add('done');
          thinkT.textContent = thought;
          text.textContent = a;
        } else {
          const waitVisible = watch(panel);
          (async () => {
            for (;;) {
              panel.classList.remove('chatting');
              all.forEach((el) => el.classList.remove('show'));
              think.classList.remove('done');
              thinkT.textContent = thinking;
              typed.textContent = text.textContent = '';
              await waitVisible();
              await sleep(900);
              for (const ch of q) {
                typed.textContent += ch;
                await sleep(90 + Math.random() * 80);
              }
              await sleep(500);
              send.classList.add('press');
              await sleep(150);
              send.classList.remove('press');
              typed.textContent = '';
              panel.classList.add('chatting');
              show(ask);
              await sleep(400);
              show(think);
              await sleep(500);
              for (const st of steps) {
                st.classList.add('run');
                show(st);
                await sleep(700);
                st.classList.remove('run');
                await sleep(150);
              }
              think.classList.add('done');
              thinkT.textContent = thought;
              show(ans);
              show(text);
              for (const ch of a) {
                text.textContent += ch;
                await sleep(35);
              }
              for (const b of bills) {
                await sleep(220);
                show(b);
              }
              await sleep(300);
              show(cite);
              await sleep(6000);
            }
          })();
        }
      }

      // 终端演示：打出安装命令，再按各步骤的大致耗时逐行显示输出，并自动滚到底部
      const term = document.querySelector<HTMLElement>('[data-term]');
      if (term) {
        const cmd = term.querySelector<HTMLElement>('.tw-cmd')!;
        const lines = [...term.querySelectorAll<HTMLElement>('.tl')].slice(1);
        const CMD = term.dataset.cmd ?? '';
        if (reduced) {
          cmd.textContent = CMD;
          lines.forEach((l) => l.classList.add('show'));
          term.classList.add('done');
          term.scrollTop = term.scrollHeight;
        } else {
          const waitVisible = watch(term);
          const DELAY = [500, 120, 900, 500, 400, 700, 300, 900, 500, 500, 300, 400, 300, 600, 500, 900, 200, 200, 150, 120];
          const toBottom = (smooth: boolean) => term.scrollTo({ top: term.scrollHeight, behavior: smooth ? 'smooth' : 'instant' });
          (async () => {
            for (;;) {
              cmd.textContent = '';
              term.classList.remove('done');
              lines.forEach((l) => l.classList.remove('show'));
              toBottom(false);
              await waitVisible();
              await sleep(700);
              for (const ch of CMD) {
                cmd.textContent += ch;
                await sleep(45 + Math.random() * 50);
              }
              await sleep(400);
              term.classList.add('done');
              for (let i = 0; i < lines.length; i++) {
                await sleep(DELAY[i] ?? 300);
                lines[i]!.classList.add('show');
                toBottom(true);
              }
              await sleep(7000);
            }
          })();
        }
      }
    </script>
  </body>
</html>
